APP_NAME=MemberFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=memberflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email: "log" = local testing (written to storage/logs/mail.log, NOT delivered)
#        "smtp" = real delivery (Gmail: smtp.gmail.com:587 + a 16-char App Password).
# There is no automatic fallback. See docs/email-and-security.md.
# Laravel 12 uses MAIL_SCHEME (null/smtp = STARTTLS on 587, smtps = TLS on 465) instead of MAIL_ENCRYPTION.
# Run "php artisan queue:work" to send queued emails; restart it after changing these values.
# QUEUE_CONNECTION=database is the production setting (retries, fast requests, needs the worker).
# QUEUE_CONNECTION=sync is fine for a local demo: emails are sent in the request right after the
# DB commit, failures are recorded in the Email log (no automatic retry), no worker is needed.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@memberflow.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Manila
# Optional integrations — the app works without them (manual coordinates, "weather unavailable").
# GOOGLE_MAPS_KEY is a BROWSER key (visible in pages): restrict it in Google Cloud to your
# HTTP referrers (e.g. http://127.0.0.1:8000/*) and to the "Maps JavaScript API" only.
# GOOGLE_MAPS_MAP_ID defaults to Google's DEMO_MAP_ID (fine for development).
# OPENWEATHER_KEY is a SERVER key (never sent to the browser). See docs/maps-and-weather.md.
GOOGLE_MAPS_KEY=
GOOGLE_MAPS_MAP_ID=
OPENWEATHER_KEY=
OPENWEATHER_TIMEOUT=5
OPENWEATHER_CACHE_MINUTES=10
MEMBERFLOW_ADMIN_NAME="MemberFlow Administrator"
MEMBERFLOW_ADMIN_EMAIL=
MEMBERFLOW_ADMIN_PASSWORD=

# HTTPS behind a hosting proxy (leave empty for local XAMPP). See docs/deployment.md §7.
# TRUSTED_PROXIES: "*" (shared hosting such as InfinityFree) or a comma-separated list of proxy IPs.
# TRUSTED_PROXY_FORWARDED_FOR: true only if the proxy overwrites X-Forwarded-For (client IP for rate limits).
# FORCE_HTTPS: true makes every generated URL https.
TRUSTED_PROXIES=
TRUSTED_PROXY_FORWARDED_FOR=false
FORCE_HTTPS=false
