# --- MemberFlow hardening (never commit secrets, data, logs or local tooling) ---
# Every environment file except the template
.env.*
!.env.example
# Database exports, dumps and their checksums
*.sql
*.sql.gz
*.sql.zip
*.sql.sha256
*.dump
*.SHA256SUMS
SHA256SUMS*
# Logs and local runtime files (storage/* subfolders also have their own .gitignore)
*.log
/storage/logs/*
!/storage/logs/.gitignore
/bootstrap/cache/*.php
# Keys and certificates
*.key
*.pem
*.p12
*.pfx
# The professor's course materials (kept locally, not redistributed)
/files and instructions/
# Local Claude Code settings (may contain local permissions/paths)
/.claude/settings.local.json
# Backups, temporary and OS files
*.bak
*.backup
*.tmp
*.swp
~$*
Thumbs.db
desktop.ini
.DS_Store

